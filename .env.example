# Copy to `.env` and fill in. Bun loads `.env` automatically on `bun run`.

# --- Artifact storage (Google Cloud Storage) ---

# Bucket that holds deploy artifacts (required). This is the bucket name only,
# not the gs:// URL. Must be globally unique across GCS.
# Example: GCS_BUCKET=my-portal-bucket
GCS_BUCKET=

# Google Cloud project id that owns the bucket (optional). Leave empty to use
# the project inferred from the service-account credentials.
# Example: GOOGLE_PROJECT_ID=my-gcp-project
GOOGLE_PROJECT_ID=

# @google-cloud/storage authenticates via Application Default Credentials.
# Point it at your service-account key JSON (not read by the app config, but
# required for storage to work). See README "How to get the keys".
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\portal-sa-key.json

# --- Deploy registry (Postgres) ---

# Postgres connection string for deploy metadata (required). The registry
# creates its tables automatically via migrations on startup.
# Example: DATABASE_URL=postgresql://postgres:portal@localhost:5432/portal
DATABASE_URL=

# --- Server & local state ---

# Local server port (optional, default 8080).
PORT=8080

# Directory for local state: build logs, extracted serve cache (optional,
# default .portal).
DATA_DIR=.portal