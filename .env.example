# Copy to `.env` and fill in. Bun loads `.env` automatically on `bun run`.

# --- Artifact storage (Cloudflare R2) ---

# Cloudflare account id for the R2 endpoint. From the R2 dashboard
# (Overview → Account ID), or the endpoint's `<ACCOUNT_ID>.r2.cloudflarestorage.com`.
# Example: R2_ACCOUNT_ID=8a2c7f1d3e9b4c5a6d7e8f90a1b2c3d4
R2_ACCOUNT_ID=

# R2 API token credentials. Create these in the R2 dashboard:
# Manage R2 API Tokens → Create API Token. Both are required.
# Example: R2_ACCESS_KEY_ID=e4f...  R2_SECRET_ACCESS_KEY=9a2b...
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket that holds deploy artifacts (required).
# Example: R2_BUCKET=my-portal-bucket
R2_BUCKET=

# --- Deploy registry (Postgres) ---

# Postgres connection string for deploy metadata (required). The registry
# creates its tables automatically via migrations on startup.
# Example: DATABASE_URL=postgresql://postgres:portal@localhost:5432/portal
DATABASE_URL=

# --- Server & local state ---

# Local server port (optional, default 8080).
PORT=8080

# Directory for local state: build logs, extracted serve cache (optional,
# default .portal).
DATA_DIR=.portal