# Copy to `.env` and fill in. Bun loads `.env` automatically on `bun run`.

# --- Artifact storage (Supabase Storage, S3-compatible) ---

# Supabase project ref for the S3 endpoint. From the Supabase dashboard
# (Project Settings → API), or the endpoint's
# `https://<PROJECT_REF>.supabase.co/storage/v1/s3`.
# Example: SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_PROJECT_REF=

# S3 access keys. Create these in the Supabase dashboard:
# Project Settings → API → Storage → S3 Access Keys. Both are required.
# Example: SUPABASE_S3_ACCESS_KEY_ID=e4f...  SUPABASE_S3_SECRET_ACCESS_KEY=9a2b...
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Signing region for the S3 gateway. Supabase's S3 endpoint signs requests
# with `us-east-1` regardless of where the project is hosted, so keep this
# at `us-east-1` unless you've verified a different region works.
# Example: SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_REGION=

# Bucket that holds deploy artifacts (required).
# Example: SUPABASE_BUCKET=my-portal-bucket
SUPABASE_BUCKET=

# --- Deploy registry (Postgres) ---

# Postgres connection string for deploy metadata (required). The registry
# creates its tables automatically via migrations on startup.
# For managed providers (e.g. Neon, Supabase) use `sslmode=verify-full` to
# silence the pg sslmode deprecation warning (do not use bare `sslmode=require`).
# Example: DATABASE_URL=postgresql://postgres:portal@localhost:5432/portal
DATABASE_URL=

# --- Server & local state ---

# Local server port (optional, default 8080).
PORT=8080

# Directory for local state: build logs, extracted serve cache (optional,
# default .portal).
DATA_DIR=.portal